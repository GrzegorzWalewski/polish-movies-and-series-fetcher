{
  "name": "polish-movies-and-series-fetcher",
  "version": "1.0.0",
  "description": "CLI: search movies/series via TMDB, then fetch available stream links from Polish streaming sites",
  "type": "module",
  "bin": {
    "msf": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cheerio": "^1.0.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
