# TMDB read access token (JWT) — required.
# Get one for free at https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# FlareSolverr instance for automatic Cloudflare bypass (optional, recommended).
# Without it, some Cloudflare-protected sites will be skipped with a warning.
#   docker run -d --name flaresolverr -p 8191:8191 --restart unless-stopped \
#     ghcr.io/flaresolverr/flaresolverr
FLARESOLVERR_URL=http://localhost:8191

# --- filman.cc auto-session (optional, recommended) ---------------------------
#
# filman requires a logged-in session behind Cloudflare. Auto mode keeps it
# working indefinitely: FlareSolverr re-solves the daily CF challenge for free,
# and a full re-login (reCAPTCHA Enterprise, solved via 2Captcha, ~$0.003 per
# login) only happens when the session itself dies. The session cache is kept
# in .filman-session.json (gitignored). Requires a 2captcha.com API key.
#FILMAN_CC_LOGIN=your-filman-username
#FILMAN_CC_PASSWORD=your-filman-password
#TWOCAPTCHA_API_KEY=your-2captcha-api-key

# --- Manual cookie overrides (optional) --------------------------------------
#
# Fallback when the filman auto-session above is not fully configured. Copy
# the full cookie header (cf_clearance + session cookies) and User-Agent from
# your browser devtools. Re-copy when the CF warning reappears (cookies
# expire daily). Ignored while auto mode is fully configured.
#FILMAN_CC_COOKIE=cf_clearance=...; user_id=...; PHPSESSID=...; BKD_REMEMBER=...
#FILMAN_CC_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:159.0) Gecko/20100101 Firefox/159.0
#
# cda-hd.cc also accepts a manual override, but works fully auto-solved with
# FlareSolverr — only set these if FlareSolverr is unavailable.
#CDA_HD_CC_COOKIE=cf_clearance=...; ...
#CDA_HD_CC_UA=Mozilla/5.0 ...
