# TMDB read access token (JWT) — required.
# Get one for free at https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# FlareSolverr instance for automatic Cloudflare bypass (optional, recommended).
# Without it, some Cloudflare-protected sites will be skipped with a warning.
#   docker run -d --name flaresolverr -p 8191:8191 --restart unless-stopped \
#     ghcr.io/flaresolverr/flaresolverr
FLARESOLVERR_URL=http://localhost:8191

# --- Manual cookie overrides (optional) --------------------------------------
#
# filman.cc requires a logged-in session and cannot be auto-solved (its login
# is gated by reCAPTCHA Enterprise and the session is UA-bound). Copy the full
# cookie header (cf_clearance + session cookies) and User-Agent from your
# browser devtools. Re-copy when the CF warning reappears (cookies expire).
#FILMAN_CC_COOKIE=cf_clearance=...; user_id=...; PHPSESSID=...; BKD_REMEMBER=...
#FILMAN_CC_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:159.0) Gecko/20100101 Firefox/159.0
#
# cda-hd.cc also accepts a manual override, but works fully auto-solved with
# FlareSolverr — only set these if FlareSolverr is unavailable.
#CDA_HD_CC_COOKIE=cf_clearance=...; ...
#CDA_HD_CC_UA=Mozilla/5.0 ...
